# Reply Portal — admin dashboard passcode (/admin/). Set as a Vercel
# encrypted Environment Variable (Project → Settings → Environment Variables),
# NOT prefixed VITE_ — that would bundle it into client JS. It's read only by
# the serverless functions under /api/, server-side.
ADMIN_PASSCODE=

# Order/enquiry shared store — Upstash Redis (Vercel Storage tab → Browse
# Storage → Upstash → Create Database shows both values directly). Without
# these, orders/enquiries still save via each browser's own localStorage and
# emails still send, but the admin dashboard only shows orders placed on the
# same device/browser it's viewed from — set these for a real shared inbox.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP — branded transactional emails (order confirmation, admin
# notification, payment-details, enquiry notification/reply). Without these,
# sendMail() returns {sent:false} and every endpoint still responds normally —
# orders/enquiries still save, the UI just shows "email not sent" and falls
# back to the WhatsApp links. Any standard SMTP provider works (Zoho, Gmail
# with an app password, SES, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset.
SMTP_FROM=

# DNS records to add once the domain is live, for deliverability (not
# fixable in code):
#   SPF:   TXT @ "v=spf1 include:<your-smtp-provider> ~all"
#   DKIM:  CNAME/TXT records from your SMTP provider's dashboard
#   DMARC: TXT _dmarc "v=DMARC1; p=quarantine; rua=mailto:dmarc@alliedelectricvehicles.com.au"

# Local dev: `vercel dev` reads these from a `.env` file (gitignored) or your
# shell env. Plain `npm run dev` (Vite only, no functions) just runs the SPA —
# /api/* calls will fail locally and every store falls back to localStorage,
# which is fine for UI work.
